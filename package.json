{
  "name": "h3-video-workbench",
  "version": "1.0.1-rc.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8790",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8790",
    "test": "npm run test:node && npm run test:browser",
    "test:all": "npm run test:python && npm test",
    "test:python": "python -m unittest discover -s . -p \"test_*.py\" -t .",
    "test:node": "node scripts/run_node_tests.mjs node",
    "test:browser": "node scripts/run_node_tests.mjs browser",
    "browser:install": "playwright-core install chromium"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
